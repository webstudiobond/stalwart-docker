# Unprivileged runtime host UID/GID (check with: id <user>)
APP_UID=2000
APP_GID=2000

# Dedicated public host IP (defaults to 127.0.0.1 for isolated bootstrap; replace with public IP in production)
HOST_IP=127.0.0.1
# Optional dedicated public host IPv6 (requires adding matching "[${HOST_IP6}]:port" entries in docker-compose.yaml)
# HOST_IP6=

# Container image versions
# POSTGRES_VERSION=18-alpine
# VALKEY_VERSION=9-alpine
# STALWART_VERSION=latest
# STALWART_CLI_VERSION=latest
